msgstr "_Tutup"

#: ../src/gtk-helpers/event_config_dialog.c:140
msgid "Show password"
msgstr "Tampilkan kata sandi"

#: ../src/gtk-helpers/event_config_dialog.c:263
msgid "Don't store passwords"
