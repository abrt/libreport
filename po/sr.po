#: ../src/cli/cli.c:66
msgid ""
"& [-vsp] -L[PREFIX] [PROBLEM_DIR]\n"
"   or: & [-vspy] -e EVENT PROBLEM_DIR\n"
"   or: & [-vspy] -d PROBLEM_DIR\n"
"   or: & [-vspy] -x PROBLEM_DIR"
msgstr ""
"& [-vsp] -L[ПРЕФИКС] [ДИР_ПРОБЛЕМА]\n"
"   или: & [-vspy] -e ДОГАЂАЈ ДИР_ПРОБЛЕМА\n"
"   или: & [-vspy] -d ДИР_ПРОБЛЕМА\n"
"   или: & [-vspy] -x ДИР_ПРОБЛЕМА"

