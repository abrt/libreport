msgstr "ໂປຣເຊສ gzip ລົ້ມເຫຼວ"

#: ../src/lib/event_config.c:399
msgid "Missing mandatory value"
msgstr "ຂາດຄ່າທີ່ບັງຄັບ"

#: ../src/lib/event_config.c:407
#, c-format
msgid "Invalid utf8 character '%c'"
msgstr "ຕົວອັກສອນ utf8 ບໍ່ຖືກຕ້ອງ '%c'"

#: ../src/lib/event_config.c:420
#, c-format
msgid "Invalid number '%s'"
msgstr "ຕົວເລກບໍ່ຖືກຕ້ອງ '%s'"

#: ../src/lib/event_config.c:435
#, c-format
msgid "Invalid boolean value '%s'"
msgstr "ຄ່າ boolean ບໍ່ຖືກຕ້ອງ '%s'"

#: ../src/lib/event_config.c:441
msgid "Unsupported option type"
msgstr "ປະເພດຕົວເລືອກທີ່ບໍ່ຮອງຮັບ"

#: ../src/lib/event_config.c:516
#, c-format
msgid ""
"The problem cannot be reported due to an invalid data. '%s' file does not "
"contain a number."
msgstr "ບໍ່ສາມາດລາຍງານບັນຫາໄດ້ເນື່ອງຈາກຂໍ້ມູນບໍ່ຖືກຕ້ອງ. ໄຟລ໌ '%s' ບໍ່ມີຕົວເລກ."

#: ../src/lib/event_config.c:520
msgid "Please report this problem to ABRT project developers."
msgstr "ກະລຸນາລາຍງານບັນຫານີ້ໃຫ້ນັກພັດທະນາໂຄງການ ABRT ຊາບ."

#: ../src/lib/event_config.c:526
msgid ""
"The backtrace is incomplete, please make sure you provide the steps to "
"reproduce."
msgstr "Backtrace ບໍ່ສົມບູນ, ກະລຸນາແນ່ໃຈວ່າທ່ານໄດ້ໃຫ້ຂັ້ນຕອນການເຮັດໃຫ້ເກີດຊ້ຳ."

#: ../src/lib/event_config.c:527
msgid "The backtrace probably can't help developer to diagnose the bug."
msgstr "Backtrace ອາດຈະບໍ່ສາມາດຊ່ວຍນັກພັດທະນາວິນິໄສບັກ (bug) ໄດ້."

#: ../src/lib/event_config.c:533
msgid ""
"Reporting is disabled because the generated backtrace has low informational "
"value."
msgstr "ການລາຍງານຖືກປິດໄວ້ເນື່ອງຈາກ backtrace ທີ່ສ້າງຂຶ້ນມີມູນຄ່າຂໍ້ມູນຕ່ຳ."

#: ../src/lib/event_config.c:537
#, c-format
msgid ""
"Please try to install debuginfo manually using the command: \"debuginfo-"
"install %s\" and try again."
msgstr ""
"ກະລຸນາລອງຕິດຕັ້ງ debuginfo ດ້ວຍຕົນເອງໂດຍໃຊ້ຄຳສັ່ງ: \"debuginfo-install %s\" ແລ້ວລອງໃໝ່ອີກ"
"ຄັ້ງ."

#: ../src/lib/event_config.c:539
msgid "A proper debuginfo is probably missing or the coredump is corrupted."
msgstr "ອາດຂາດ debuginfo ທີ່ເໝາະສົມ ຫຼື coredump ເສຍຫາຍ."

#: ../src/lib/iso_date_string.c:50
#, c-format
msgid "String doesn't seem to be a date: '%s'"
msgstr "ຂໍ້ຄວາມເບິ່ງຄືວ່າບໍ່ແມ່ນວັນທີ: '%s'"

#: ../src/lib/iso_date_string.c:55
