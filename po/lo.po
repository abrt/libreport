msgstr "gzip ຖືກຂ້າດ້ວຍສັນຍານ %d"

#: ../src/lib/dump_dir.c:2533
#, c-format
msgid "gzip exited with %d"
msgstr "gzip ອອກດ້ວຍ %d"

#: ../src/lib/dump_dir.c:2536
